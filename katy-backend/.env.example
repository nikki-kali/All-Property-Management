# Supabase Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Brevo
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=hello@katypropertysolutions.com

# Server
PORT=4000

# Admin auth (Phase 1 — single admin user, Katy only)
ADMIN_EMAIL=katy@katypropertysolutions.com
ADMIN_PASSWORD=change_me
JWT_SECRET=replace_with_a_long_random_string

# Shared secret for the daily reminders cron trigger (GET /api/reminders/run),
# sent as the x-cron-secret header by the external scheduler (Render Cron / Supabase Scheduled Function)
CRON_SECRET=replace_with_a_long_random_string
